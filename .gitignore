__pycache__/
*.pyc
.pytest_cache/
dist/
*.egg-info/
.uv/
logs/
.superpowers/

# throwaway texture maps the tool-gaps live gate writes for assign_pbr
evals/_tool_gaps_maps/

# golem look-dev work copies and their auto-checkpoints (generated)
evals/golem_run/golem_m1_pass.mb
evals/golem_run/checkpoints/

# #601 run: per-task recovery scenes and auto-checkpoints. These exist so a
# wedged Maya costs one task, not the run; the deliverable scene is committed
# once at the end.
evals/golem_run_2/golem_task*.mb
evals/golem_run_2/checkpoints/

# Same rule for the delivery scene: the package is the FBX, the manifest, the
# poses and the renders. 71 MB of auto-checkpoints from posing the rig is not
# part of it.
evals/golem_delivery/checkpoints/

# Arnold's auto-generated tiled textures, written next to any map it renders
*.tx

# probe FBXs the #642 export gate writes; regenerated by evals/export_live.py
evals/export_live/

# and the #646 whole-scene/ancestor probes, rebuilt by evals/export_scene_live.py
evals/export_scene_live/

# maya-mcp #645 live gate: the scene it authors to carry RotationOffset /
# PreRotation / ScalingPivot is rebuilt on every run
evals/fbx_probe_live/
evals/image_tools_live/

# Same rule as every other run above: auto-checkpoints are the safety net for a
# wedged Maya, not part of the delivery. #665 rerun and the lizard run, folded in
# from D:\devel\ where they were built.
evals/golem_rerun_665/out/checkpoints/
evals/golem_rerun_665/out_v3/checkpoints/
evals/lizard_run/checkpoints/

# #718 Task 10b determinism probe: the per-run FBXs it writes are throwaway,
# rebuilt on every run of evals/clip_export_determinism_live.py
evals/clip_export_determinism_live/

# #729 Step 1 fps-cache probe: the seed/control/trial FBXs are throwaway,
# rebuilt on every run of evals/fbx_fps_probe.py
evals/fbx_fps_probe_out/

# #714 Task 8 bake probes: the PNGs/FBXs are throwaway, rebuilt (and
# explicitly deleted-and-reasserted-gone) on every run of
# evals/bake_probe_714.py
evals/bake_probe_714_out/

# #714 phase 2 Task 6 live gate: before/after renders and FBXs, rebuilt on
# every run of evals/texbake_live.py --build
evals/texbake_live/

# user-stocked local mocap clips (#774) - repo ships only evals/mocap_fixtures/
mocap/

# The kethran creature run (2026-09-05, the second fresh-agent art run - its
# friction report is the source of the tickets that followed). Same rule as
# the lizard run: the scene, the reports and the renders are committed; the
# auto-checkpoints and the recovered checkpoint copy are the safety net, not
# the delivery.
evals/kethran_run/checkpoints/
evals/kethran_run/kethran_recovered.ma

# The kethran armour/scars/face pass (2026-09-06, kethran2/). Same rule as the
# run above: the scenes, the reports, the map sources and the finals are
# committed. Excluded are the auto-checkpoints (88 MB safety net), the Maya
# workspace scaffolding, and the superseded texture iterations - Maya caches a
# file node by PATH, so every texture edit needed a new filename and the folder
# accumulated v3..v9 of the albedo and v2..v6 of the height map. Only the two
# the scene actually reads (hide_albedo_v10, body_height_v7), their inputs
# (hide_albedo_v2, body_height) and the debug masks' source are kept.
evals/kethran_run/kethran2/checkpoints/
evals/kethran_run/kethran2/agent_project/
evals/kethran_run/kethran2/maps/hide_albedo_v[3-9].png
evals/kethran_run/kethran2/maps/hide_albedo_v6_greentest.png
evals/kethran_run/kethran2/maps/body_height_v[2-6].png
evals/kethran_run/kethran2/maps/scar_debug_*.png
evals/kethran_run/kethran2/maps/probe_flat.png
